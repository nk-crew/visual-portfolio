<wpml-config>
	<gutenberg-blocks>
		<gutenberg-block type="visual-portfolio/block" translate="1">
			<key name="images">
				<key name="*">
					<key name="title" />
					<key name="description" />
					<key name="author" />
					<key name="categories" />
				</key>
			</key>
			<key name="no_items_notice" />
			<key name="items_style_default__date_format" />
			<key name="items_style_default__read_more_label" />
			<key name="items_style_fade__date_format" />
			<key name="items_style_fly__date_format" />
			<key name="items_style_emerge__date_format" />
			<key name="filter_text_all" />
			<key name="pagination_infinite_text_load" />
			<key name="pagination_infinite_text_loading" />
			<key name="pagination_infinite_text_end_list" />
			<key name="pagination_load_more_text_load" />
			<key name="pagination_load_more_text_loading" />
			<key name="pagination_load_more_text_end_list" />
		</gutenberg-block>
		<gutenberg-block type="visual-portfolio/loop" translate="1">
			<key name="imagesQuery">
				<key name="images">
					<key name="*">
						<key name="title" />
						<key name="description" />
						<key name="alt" />
						<key name="author" />
						<key name="categories" />
					</key>
				</key>
			</key>
		</gutenberg-block>
		<gutenberg-block type="visual-portfolio/loop-filter-item" translate="1">
			<key name="text" />
		</gutenberg-block>
		<gutenberg-block type="visual-portfolio/loop-sort" translate="1">
			<key name="labels">
				<key name="*" />
			</key>
		</gutenberg-block>
		<gutenberg-block type="visual-portfolio/loop-search" translate="1">
			<key name="placeholder" />
			<key name="label" />
		</gutenberg-block>
		<gutenberg-block type="visual-portfolio/loop-pagination-next" translate="1">
			<key name="label" />
		</gutenberg-block>
		<gutenberg-block type="visual-portfolio/loop-pagination-previous" translate="1">
			<key name="label" />
		</gutenberg-block>
		<gutenberg-block type="visual-portfolio/loop-pagination-trigger" translate="1">
			<key name="label" />
			<key name="loadingLabel" />
		</gutenberg-block>
		<gutenberg-block type="visual-portfolio/item-read-more" translate="1">
			<key name="text" />
		</gutenberg-block>
		<gutenberg-block type="visual-portfolio/item-meta" translate="1">
			<key name="prefix" />
			<key name="suffix" />
		</gutenberg-block>
		<gutenberg-block type="visual-portfolio/item-author" translate="1">
			<key name="prefix" />
		</gutenberg-block>
		<gutenberg-block type="visual-portfolio/item-categories" translate="1">
			<key name="separator" />
		</gutenberg-block>
		<gutenberg-block type="visual-portfolio/item-date" translate="1">
			<key name="format" />
		</gutenberg-block>
	</gutenberg-blocks>

	<custom-types>
		<custom-type translate="1">portfolio</custom-type>
		<custom-type translate="1">vp_lists</custom-type>
	</custom-types>
	<taxonomies>
		<taxonomy translate="1">portfolio_category</taxonomy>
		<taxonomy translate="1">portfolio_tag</taxonomy>
	</taxonomies>

	<custom-fields>
		<custom-field action="translate">vp_images</custom-field>
	</custom-fields>
	<custom-fields-texts>
		<key name="vp_images">
		<key name="*">
			<key name="title" />
			<key name="description" />
			<key name="author" />
			<key name="categories" />
		</key>
		</key>
	</custom-fields-texts>
</wpml-config>
