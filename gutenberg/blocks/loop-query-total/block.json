{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "visual-portfolio/loop-query-total",
	"title": "Gallery Query Total (Experimental)",
	"category": "media",
	"description": "Displays how many items the gallery found, or which of them are on screen. Block is experimental and will change in future releases. Please use with caution.",
	"ancestor": ["visual-portfolio/loop"],
	"textdomain": "visual-portfolio",
	"usesContext": [
		"vp/queryId",
		"vp/queryType",
		"vp/baseQuery",
		"vp/postsQuery",
		"vp/imagesQuery",
		"vp/sourceQuery",
		"vp/blockId"
	],
	"attributes": {
		"displayType": {
			"type": "string",
			"enum": ["total-results", "range-display"],
			"default": "total-results"
		},
		"extensions": {
			"type": "object",
			"default": {}
		}
	},
	"supports": {
		"html": false,
		"reusable": false,
		"anchor": true,
		"align": ["wide", "full"],
		"color": {
			"text": true,
			"gradients": true,
			"__experimentalDefaultControls": {
				"text": true,
				"background": true
			}
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true,
			"textAlign": true,
			"__experimentalFontFamily": true,
			"__experimentalFontWeight": true,
			"__experimentalFontStyle": true,
			"__experimentalTextTransform": true,
			"__experimentalTextDecoration": true,
			"__experimentalLetterSpacing": true,
			"__experimentalDefaultControls": {
				"fontSize": true
			}
		},
		"spacing": {
			"margin": true,
			"padding": true
		}
	}
}
