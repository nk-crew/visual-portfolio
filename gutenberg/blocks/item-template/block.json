{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "visual-portfolio/item-template",
	"title": "Gallery Item Template (Experimental)",
	"category": "media",
	"description": "Contains the block elements used to render a gallery item, like the image, title, description and more. Block is experimental and will change in future releases. Please use with caution.",
	"ancestor": ["visual-portfolio/loop"],
	"textdomain": "visual-portfolio",
	"attributes": {
		"layoutType": {
			"type": "string",
			"default": "grid",
			"enum": ["grid", "masonry"]
		},
		"layoutColumns": {
			"type": "number",
			"default": 3
		},
		"layoutGap": {
			"type": "string",
			"default": "1.5rem"
		}
	},
	"supports": {
		"html": false,
		"reusable": false,
		"anchor": true,
		"interactivity": true,
		"color": {
			"text": true,
			"gradients": true,
			"__experimentalDefaultControls": {
				"text": true,
				"background": true
			}
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true,
			"__experimentalFontFamily": true,
			"__experimentalTextDecoration": true,
			"__experimentalFontStyle": true,
			"__experimentalFontWeight": true,
			"__experimentalLetterSpacing": true,
			"__experimentalTextTransform": true,
			"__experimentalWritingMode": true,
			"__experimentalDefaultControls": { "fontSize": true }
		},
		"spacing": {
			"padding": true,
			"margin": ["top", "bottom"]
		},
		"__experimentalBorder": {
			"radius": true,
			"color": true,
			"width": true,
			"style": true
		}
	},
	"usesContext": [
		"vp/queryType",
		"vp/baseQuery",
		"vp/postsQuery",
		"vp/imagesQuery",
		"vp/blockId"
	],
	"style": "visual-portfolio-block-item-template"
}
