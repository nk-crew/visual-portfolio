{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "visual-portfolio/loop-carousel-indicator",
	"title": "Carousel Indicator (Experimental)",
	"category": "media",
	"description": "Says which slide of a carousel gallery is on screen, as dots or as a bar. Block is experimental and will change in future releases. Please use with caution.",
	"keywords": [
		"carousel",
		"slider",
		"dots",
		"bullets",
		"pagination",
		"progress"
	],
	"parent": [
		"visual-portfolio/loop",
		"visual-portfolio/item-template",
		"visual-portfolio/loop-carousel-nav"
	],
	"textdomain": "visual-portfolio",
	"usesContext": ["vp/queryType"],
	"attributes": {
		"indicator": {
			"type": "string",
			"default": "dots",
			"enum": ["dots", "progress", "counter"]
		},
		"showOnHover": { "type": "boolean", "default": false },
		"maxDots": { "type": "number", "default": 0 },
		"isDraggable": { "type": "boolean", "default": true }
	},
	"supports": {
		"html": false,
		"className": true,
		"anchor": true,
		"reusable": false,
		"color": {
			"text": true,
			"background": false,
			"gradients": false,
			"__experimentalDefaultControls": { "text": true }
		},
		"spacing": {
			"margin": true,
			"__experimentalDefaultControls": { "margin": false }
		}
	},
	"styles": [
		{ "name": "default", "label": "Plain", "isDefault": true },
		{ "name": "outlined", "label": "Outlined" },
		{ "name": "filled", "label": "Filled" }
	],
	"selectors": { "root": ".vp-block-loop-carousel-indicator" },
	"style": "visual-portfolio-block-loop-carousel",
	"editorStyle": "visual-portfolio-block-loop-carousel-editor"
}
